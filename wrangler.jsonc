{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-07",
	"compatibility_flags": ["nodejs_compat"],
	"env": {
		"dev": {
			"name": "brain-backend-dev",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "brain-dev",
					"database_id": "94f3e393-d264-42ed-8c4c-9265cff7df17"
				}
			],
			"routes": [
				{
					"pattern": "dev.mohakapoor.in",
					"custom_domain": true
				}
			]
		},
		"prod": {
			"name": "brain-backend-prod",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "brain-prod",
					"database_id": "92551797-d4ce-4d7a-9f2f-ad879ac57ef0"
				}
			],
			"routes": [
				{
					"pattern": "api.mohakapoor.in",
					"custom_domain": true
				}
			]
		}
	}
}